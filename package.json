{
  "name": "garminactivitydash",
  "version": "1.0.0",
  "description": "Self-hosted Garmin Connect dashboard with training analytics, recovery metrics, muscle maps, and optional Claude CLI coaching — all data stays local.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "finnley07",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finnley07/GarminActivityDashboard.git"
  },
  "bugs": {
    "url": "https://github.com/finnley07/GarminActivityDashboard/issues"
  },
  "homepage": "https://github.com/finnley07/GarminActivityDashboard#readme",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client:wait\"",
    "dev:client": "vite",
    "dev:client:wait": "wait-on -t 90000 -d 1500 -i 500 tcp:127.0.0.1:3001 && npm run dev:client",
    "dev:server": "node --import tsx --watch server/index.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "node --import tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chart.js": "^4.4.8",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.11.6",
    "npm-run-all2": "^9.0.2",
    "tsx": "^4.19.3",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.7",
    "wait-on": "^8.0.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
