# Optional fallback – recommended: configure everything in the in-app setup (gear icon).
# Values migrate to data/app-config.json on first start when Garmin credentials are set.

GARMIN_EMAIL=you@email.com
GARMIN_PASSWORD=yourpassword

# Server
PORT=3001
# HOST=127.0.0.1
# This API has no authentication - only bind beyond 127.0.0.1 if you understand
# that tradeoff (see SECURITY.md). Leave commented out to stay loopback-only.

# Claude CLI (optional)
# CLAUDE_CLI_PATH=C:\Users\...\AppData\Roaming\npm\claude.cmd
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_FALLBACK_MODEL=claude-sonnet-5
# CLAUDE_EFFORT=low
# CLAUDE_MAX_COST_USD=0
# CLAUDE_ANALYSIS_MODE=smart
# CLAUDE_MAX_ACTIVITIES=5
# CLAUDE_TIMEOUT_SECONDS=180

# Sync & caching (optional)
# MAX_ACTIVITIES_LIMIT=500
# METRICS_HISTORY_DAYS=84
# INCREMENTAL_SYNC_BUFFER_DAYS=1
# GARMIN_SESSION_IDLE_MINUTES=5
# DETAIL_CACHE_DAYS=7

